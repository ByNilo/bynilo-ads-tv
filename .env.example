# OpenAI API Key (obligatoria para moderación con IA)
OPENAI_API_KEY=

# Puerto del servidor
PORT=3000

# false = sitio web en la nube sin PC de transmisión (solo reservas)
# true  = PC de transmisión con Just Broadcast conectado
EMISION_TV_ACTIVA=true

# Carpeta de datos (reservas pendientes, facturas en modo web)
DATA_DIR=./data

# Carpeta Just Broadcast (solo cuando EMISION_TV_ACTIVA=true)
JUST_BROADCAST_FOLDER=C:/JustBroadcast/Output

# Orígenes permitidos para CORS (separados por coma)
# Ejemplo producción: https://byniloads.cl,https://www.byniloads.cl
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Mercado Pago (Checkout Pro)
# Credenciales en: https://www.mercadopago.cl/developers/panel/app
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_SANDBOX=true
# Dejar en false (default) para usar init_point — recomendado en Chile con credenciales de prueba
MERCADOPAGO_SANDBOX_URL=false
# En Render suele bastar RENDER_EXTERNAL_URL (automática). Si tienes dominio propio, úsalo aquí.
PUBLIC_BASE_URL=https://bynilo-ads-tv.onrender.com
